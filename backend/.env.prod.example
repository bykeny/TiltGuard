# Template for .env.prod — copy, then replace every CHANGE_ME.
#
#   cp .env.prod.example .env.prod
#   cp .env.prod.db.example .env.prod.db
#
# .env.prod is gitignored and must stay that way: it holds the JWT signing key
# and the RevenueCat webhook secret in plaintext. On a real host, prefer a
# secrets manager or `docker secret` over a file on disk.
#
# ASP.NET Core reads a double underscore as a configuration-section separator,
# so Jwt__Secret here is the same setting as {"Jwt": {"Secret": ...}} in
# appsettings.json. Environment variables win over the JSON files.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Host is the compose service name, not localhost. The password here must match
# POSTGRES_PASSWORD in .env.prod.db — see that file for why the two are split.
ConnectionStrings__TiltGuard=Host=db;Port=5432;Database=tiltguard;Username=tiltguard;Password=CHANGE_ME_STRONG_DB_PASSWORD

# HS256 signing key. Must be valid Base64 and at least 32 bytes decoded —
# Program.cs calls Convert.FromBase64String on it and will fail fast otherwise.
#   openssl rand -base64 32
Jwt__Secret=CHANGE_ME_BASE64_32_BYTES
Jwt__Issuer=https://api.tiltguard.app
Jwt__Audience=tiltguard-mobile
Jwt__AccessTokenLifetimeMinutes=15
# 45 days per spec §1.3. The compiled default in JwtOptions is 7, so this line
# is what actually produces the specified behaviour — do not drop it.
Jwt__RefreshTokenLifetimeDays=45

# Must match the Authorization header value configured on the webhook in the
# RevenueCat dashboard, verbatim. Leaving it unset does NOT open the endpoint —
# the handler fails closed with 503 — but the webhook will reject every event.
RevenueCat__WebhookAuthHeader=CHANGE_ME_REVENUECAT_WEBHOOK_SECRET
RevenueCat__EntitlementId=tiltguard_pro
