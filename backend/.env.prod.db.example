# Template for .env.prod.db — copy, then replace every CHANGE_ME.
#
#   cp .env.prod.db.example .env.prod.db
#
# Postgres credentials only, kept separate from .env.prod on purpose. Compose
# applies an env_file to a whole service, so a single shared file would inject
# Jwt__Secret and the RevenueCat webhook secret into the database container too
# — handing anyone who can exec into Postgres the ability to forge access tokens
# for any user. Splitting the files keeps each container's environment to what
# that container actually needs.
#
# POSTGRES_PASSWORD must match the Password= in .env.prod's connection string.
# Changing one without the other is the most common way to break this stack.

POSTGRES_USER=tiltguard
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=tiltguard
